# ============================================
# SigNoz Cloud Configuration
# ============================================

# Your SigNoz Cloud endpoint - replace {your-region} with your actual region (us, eu, etc.)
SIGNOZ_ENDPOINT=https://ingest.{your-region}.signoz.cloud:443/v1/traces

# Your SigNoz access token - get this from SigNoz Cloud → Settings → Ingestion Settings
SIGNOZ_ACCESS_TOKEN=your-signoz-access-token-here

# ============================================
# Service Configuration
# ============================================

# Service identification
OTEL_SERVICE_NAME=nestjs-otel-demo
OTEL_SERVICE_VERSION=1.0.0

# Environment
NODE_ENV=development

# Optional: Port configuration
PORT=3000

# ============================================
# Alternative OTLP Configuration (if not using SigNoz)
# ============================================

# Generic OTLP endpoint (commented out - use for other observability platforms or production setups)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS={"Authorization":"Bearer your-token"}

# ============================================
# Additional Resource Attributes (Optional)
# ============================================

# Additional metadata for your service
OTEL_RESOURCE_ATTRIBUTES=service.name=nestjs-otel-demo,service.version=1.0.0,deployment.environment=development 